---
import { type Project } from '../data/portfolio';
import { Image } from 'astro:assets';

interface Props {
	project: Project;
}

const { project } = Astro.props;

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpeg,jpg,png,webp,JPG,JPEG,PNG}');
const videoFiles = import.meta.glob<{ default: string }>('../assets/images/*.mp4');

let resolvedVideo: string | undefined = undefined;
if (project.video) {
	const path = `../assets/images/${project.video}`;
	if (videoFiles[path]) {
		const mod = await videoFiles[path]();
		resolvedVideo = mod.default;
	}
}

let resolvedImages: ImageMetadata[] = [];
if (!resolvedVideo && project.images && project.images.length > 0) {
	for (const imgName of project.images) {
		const path = `../assets/images/${imgName}`;
		if (imageFiles[path]) {
			const mod = await imageFiles[path]();
			resolvedImages.push(mod.default);
		}
	}
} else if (!resolvedVideo && project.image) {
	const path = `../assets/images/${project.image}`;
	if (imageFiles[path]) {
		const mod = await imageFiles[path]();
		resolvedImages.push(mod.default);
	}
}

const cardId = Math.random().toString(36).substring(2, 9);
---

<article
	class="group flex flex-col rounded-2xl border border-zinc-800 bg-zinc-900/50 overflow-hidden transition hover:border-zinc-700 hover:bg-zinc-900/80 shadow-2xl"
>
	{
		resolvedVideo ? (
			<div class="relative w-full bg-zinc-950 border-b border-zinc-800 overflow-hidden h-80 sm:h-[450px] lg:h-[540px]">
				<video
					src={resolvedVideo}
					autoplay
					muted
					loop
					playsinline
					class="w-full h-full object-cover"
				></video>
			</div>
		) : resolvedImages.length > 0 ? (
			<div class="relative w-full bg-zinc-950 border-b border-zinc-800 overflow-hidden h-80 sm:h-[450px] lg:h-[540px]" data-carousel={cardId}>
				<div class="relative w-full h-full flex items-center justify-center">
					{
						resolvedImages.map((img, idx) => (
							<div
								class={`absolute inset-0 w-full h-full transition-opacity duration-300 ease-in-out flex items-center justify-center bg-zinc-950 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
								data-slide={idx}
							>
								<Image
									src={img}
									alt={`Captura ${idx + 1} de ${project.title}`}
									width={1400}
									height={900}
									class="w-full h-full object-cover"
								/>
							</div>
						))
					}
				</div>

				{
					resolvedImages.length > 1 && (
						<>
							<!-- Botón Anterior -->
							<button
								type="button"
								class="absolute left-3 top-1/2 -translate-y-1/2 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-zinc-900/80 border border-zinc-700 text-zinc-200 shadow-lg backdrop-blur transition hover:bg-zinc-800 hover:text-white focus:outline-none"
								data-carousel-prev={cardId}
								aria-label="Imagen anterior"
							>
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
								</svg>
							</button>

							<!-- Botón Siguiente -->
							<button
								type="button"
								class="absolute right-3 top-1/2 -translate-y-1/2 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-zinc-900/80 border border-zinc-700 text-zinc-200 shadow-lg backdrop-blur transition hover:bg-zinc-800 hover:text-white focus:outline-none"
								data-carousel-next={cardId}
								aria-label="Imagen siguiente"
							>
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</button>

							<!-- Indicadores de posición -->
							<div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 rounded-full bg-zinc-900/70 px-3 py-1.5 backdrop-blur border border-zinc-800">
								{
									resolvedImages.map((_, idx) => (
										<button
											type="button"
											class={`h-2 rounded-full transition-all ${idx === 0 ? 'w-6 bg-violet-400' : 'w-2 bg-zinc-600'}`}
											data-carousel-dot={cardId}
											data-index={idx}
											aria-label={`Ir a imagen ${idx + 1}`}
										/>
									))
								}
							</div>
						</>
					)
				}
			</div>
		) : null
	}
	<div class="flex flex-1 flex-col p-6 sm:p-8">
		<h3 class="text-2xl font-bold text-zinc-50 group-hover:text-violet-200">
			{project.title}
		</h3>
		<p class="mt-3 flex-1 text-base leading-relaxed text-zinc-400">{project.description}</p>
		<ul class="mt-5 flex flex-wrap gap-2.5" role="list">
			{
				project.tags.map((tag) => (
					<li>
						<span class="rounded-md bg-zinc-800 px-3 py-1 text-xs font-medium text-zinc-300">
							{tag}
						</span>
					</li>
				))
			}
		</ul>
		{
			project.demo !== '#' && (
				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={project.demo}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center rounded-lg bg-zinc-100 px-5 py-2.5 text-sm font-semibold text-zinc-900 transition hover:bg-white"
					>
						Demo
					</a>
				</div>
			)
		}
	</div>
</article>

{
	!resolvedVideo && resolvedImages.length > 1 && (
		<script define:vars={{ cardId, totalImages: resolvedImages.length }}>
			document.addEventListener('DOMContentLoaded', () => {
				const carousel = document.querySelector(`[data-carousel="${cardId}"]`);
				if (!carousel) return;

				let currentIndex = 0;
				const slides = carousel.querySelectorAll('[data-slide]');
				const dots = carousel.querySelectorAll('[data-carousel-dot]');
				const prevBtn = document.querySelector(`[data-carousel-prev="${cardId}"]`);
				const nextBtn = document.querySelector(`[data-carousel-next="${cardId}"]`);

				function updateSlide(newIndex) {
					slides[currentIndex].classList.remove('opacity-100', 'z-10');
					slides[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');
					if (dots[currentIndex]) {
						dots[currentIndex].classList.remove('w-6', 'bg-violet-400');
						dots[currentIndex].classList.add('w-2', 'bg-zinc-600');
					}

					currentIndex = (newIndex + totalImages) % totalImages;

					slides[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
					slides[currentIndex].classList.add('opacity-100', 'z-10');
					if (dots[currentIndex]) {
						dots[currentIndex].classList.remove('w-2', 'bg-zinc-600');
						dots[currentIndex].classList.add('w-6', 'bg-violet-400');
					}
				}

				if (prevBtn) {
					prevBtn.addEventListener('click', () => updateSlide(currentIndex - 1));
				}
				if (nextBtn) {
					nextBtn.addEventListener('click', () => updateSlide(currentIndex + 1));
				}

				dots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const idx = parseInt(dot.getAttribute('data-index'), 10);
						updateSlide(idx);
					});
				});
			});
		</script>
	)
}
