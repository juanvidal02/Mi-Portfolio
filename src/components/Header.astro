---
import { navigation, profile } from '../data/portfolio';
---

<header
	class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/85 backdrop-blur-xl"
>
	<nav
		class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
		aria-label="Principal"
	>
		<a href="#inicio" class="text-base font-bold tracking-tight text-zinc-100 transition hover:text-violet-300">
			{profile.initials}<span class="text-violet-400">.</span>
		</a>
		<ul class="flex items-center gap-1.5 text-sm font-medium text-zinc-400 sm:gap-6">
			{
				navigation.map((item) => (
					<li>
						<a
							href={item.href}
							class="rounded-lg px-3 py-1.5 transition-all hover:bg-zinc-900 hover:text-zinc-100"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
