---
import { socials } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section
	id="contacto"
	class="relative border-t border-zinc-800/80 bg-zinc-900/20 py-20 sm:py-24"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">Contacto</h2>
			<p class="mt-3 text-zinc-400">
				¿Tienes un proyecto o una oportunidad? Escríbeme por cualquiera de estos canales.
			</p>
		</div>
		<div class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
			{
				socials.map((social) => (
					<a
						href={social.href}
						target={social.id === 'email' ? undefined : '_blank'}
						rel="noopener noreferrer"
						class="flex flex-col items-center rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 text-center transition-all duration-300 hover:scale-[1.03] hover:border-violet-500/50 hover:bg-zinc-900 shadow-xl"
					>
						<span class="mb-3 rounded-full bg-violet-500/10 p-3 text-violet-400">
							<Icon name={social.id} />
						</span>
						<span class="text-sm font-semibold text-zinc-100">{social.label}</span>
						<span class="mt-1 text-xs break-all text-zinc-500">{social.handle}</span>
					</a>
				))
			}
		</div>
	</div>
</section>
