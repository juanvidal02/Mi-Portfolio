---
import { projects } from '../data/portfolio';
import ProjectCard from './ProjectCard.astro';
---

<section id="proyectos" class="relative py-20 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<h2 class="text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">
				Proyectos destacados
			</h2>
			<p class="mt-3 text-zinc-400">
				Selección de trabajos recientes con arquitectura clara y stack definido.
			</p>
		</div>

		<!-- Proyectos a ancho completo, uno debajo del otro -->
		<div class="mt-12 space-y-12">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</section>
