---
import { profile } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80 bg-zinc-950 py-10 text-center text-sm text-zinc-500">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
		<p>© {year} {profile.name}. Todos los derechos reservados.</p>
		<p class="text-xs text-zinc-600">Desarrollado con Astro y Tailwind CSS</p>
	</div>
</footer>
